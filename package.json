{
  "name": "hds-forms-js",
  "version": "0.65.1",
  "description": "HDS Form Components — React field renderers for HDS item definitions",
  "type": "module",
  "main": "js/hds-forms.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./js/hds-forms.js"
    },
    "./conversation": {
      "types": "./src/conversation/index.ts",
      "import": "./src/conversation/index.ts",
      "default": "./js/conversation.js"
    },
    "./src/*": "./src/*",
    "./js/*": "./js/*",
    "./css/*": "./css/*"
  },
  "files": [
    "js",
    "src",
    "css"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "vite build",
    "setup": "sh ./scripts/setup.sh",
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-app": "npm --prefix src-test-app run dev",
    "test-app:setup": "npm --prefix src-test-app install",
    "build:app": "npm --prefix src-test-app run build",
    "license": "source-licenser -c .licenser.yml ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/healthdatasafe/hds-forms-js.git"
  },
  "keywords": [
    "HDS",
    "Health",
    "Data",
    "Safe",
    "forms"
  ],
  "author": "Health Data Safe (https://www.healthdatasafe.org)",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "hds-feminine-cycle-ui": "github:healthdatasafe/hds-feminine-cycle-ui#semver:>=0.18.0",
    "hds-lib": "github:healthdatasafe/hds-lib-js#semver:>=2.74.0",
    "pdfjs-dist": "^6.4.299",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "hds-feminine-cycle-ui": "github:healthdatasafe/hds-feminine-cycle-ui#0.19.1",
    "hds-lib": "github:healthdatasafe/hds-lib-js#2.78.0",
    "neostandard": "^0.12.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "source-licenser": "^2.0.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": false,
    "github:healthdatasafe/hds-feminine-cycle-ui": true,
    "github:healthdatasafe/hds-lib-js": true
  }
}
